{
  "name": "setu-frontend",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*", "apps/*", "e2e"],
  "scripts": {
    "build": "tsc -b packages/contract packages/api-client packages/mock-backend packages/ui",
    "typecheck": "npm run build && tsc -p tsconfig.typecheck.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint packages",
    "clean": "rm -rf packages/*/dist packages/*/*.tsbuildinfo"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
