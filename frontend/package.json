{
  "name": "setu-frontend",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "e2e"
  ],
  "scripts": {
    "build": "tsc -b packages/contract packages/api-client packages/geo packages/mock-backend packages/ui && node scripts/run-apps.mjs build",
    "typecheck": "npm run build && tsc -p tsconfig.typecheck.json && node scripts/run-apps.mjs typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint --no-error-on-unmatched-pattern packages apps",
    "clean": "rm -rf packages/*/dist packages/*/*.tsbuildinfo",
    "test:e2e": "npm test -w @setu/e2e",
    "demo": "node scripts/demo.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
